<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net9.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings>
    <PckPackerEnabled>false</PckPackerEnabled>
    <PackToolDir Condition="Exists('$(MSBuildThisFileDirectory)../packer/tools/net9.0/any/StS2PckPacker.dll')">$(MSBuildThisFileDirectory)../packer/tools/net9.0/any</PackToolDir>
    <PackToolDir Condition="'$(PackToolDir)'==''">$(NuGetPackageRoot)bschneppe.sts2.pckpacker/0.1.1/tools/net9.0/any</PackToolDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BSchneppe.StS2.PckPacker" Version="0.1.1" PrivateAssets="all" Condition="!Exists('$(MSBuildThisFileDirectory)../packer/tools/net9.0/any/StS2PckPacker.dll')"/>
    <Reference Include="StS2PckPacker"><HintPath>$(PackToolDir)/StS2PckPacker.dll</HintPath></Reference>
    <Reference Include="SixLabors.ImageSharp"><HintPath>$(PackToolDir)/SixLabors.ImageSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
